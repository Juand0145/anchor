# Provider: auto | azure | anthropic
# auto: Azure if AZURE_OPENAI_ENDPOINT + AZURE_OPENAI_API_KEY + AZURE_OPENAI_DEPLOYMENT
# are set, else Anthropic if ANTHROPIC_API_KEY is set.
ANCHOR_LLM_PROVIDER=auto

# Anthropic (optional when Azure is configured)
ANTHROPIC_API_KEY=

# Azure OpenAI GPT deployment. All four required when provider=azure, or when
# auto selects Azure. Do not commit real secrets.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=
# Chat Completions tool calling needs an api-version that supports tools
# (e.g. 2024-08-01-preview or newer). Older versions fail tool_choice.

# Optional overrides:
# ANCHOR_MODEL=claude-haiku-4-5-20251001
# ANCHOR_MAX_TOKENS=8000
# ANCHOR_AZURE_MAX_TOKENS=8000
# ANCHOR_TARGET_INPUT_TOKENS=12000
